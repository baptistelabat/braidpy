    family-names: Labat
    email: baptiste.labat@gmail.com
    website: "https://github.com/baptistelabat"
keywords:
  - braid theory
  - braiding
  - kumihimo
  - marudai
  - sinnet
  - knot theory
  - topology
  - textile engineering
