{
  "permissions": {
    "allow": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git push * :*)"
    ]
  }
}
